---
interface Props { lang: 'tr' | 'en'; }
const { lang } = Astro.props;

const copy = {
  tr: {
    title: 'Dünya Havacılık ve Uzay Kongresi',
    place: 'İstanbul, Ekim 2027',
    lead: 'Havacılık ve uzay bilimlerini, endüstrisini ve tarihini ülke delegasyonları aracılığıyla bir araya getiren, üç yılda bir toplanan uluslararası kongrenin ilk buluşması.',
    submit: 'Bildiri gönder',
    about: 'Kongre hakkında',
    deadline: 'Bildiri gönderimi 31 Mart 2027’ye kadar açık.',
    days: 'gün kaldı',
  },
  en: {
    title: 'World Aerospace Congress',
    place: 'Istanbul, October 2027',
    lead: 'The first meeting of a triennial international congress that brings aerospace science, industry and history together through national delegations.',
    submit: 'Submit an abstract',
    about: 'About the congress',
    deadline: 'Abstract submission is open until 31 March 2027.',
    days: 'days to go',
  },
}[lang];

const submitUrl = 'https://submissions.worldaerospacecongress.org/event/2/abstracts/';
---

<section class="hero" aria-label={copy.title}>
  <video class="hero-video" autoplay muted loop playsinline preload="auto"
         poster="/images/halic-poster.jpg" aria-hidden="true"></video>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="hero-inner">
    <h1 class="hero-title">{copy.title}</h1>
    <p class="hero-place">{copy.place}</p>
    <p class="hero-lead">{copy.lead}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={submitUrl}>{copy.submit}</a>
      <a class="btn hero-line" href="#kongre">{copy.about}</a>
    </div>
    <p class="hero-note">{copy.deadline} <span class="hero-days"><span data-days>—</span> {copy.days}</span></p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    background: var(--night);
    color: #fff;
  }
  .hero-video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .hero-video.ready { opacity: 1; }
  .hero { background: var(--night) url('/images/halic-poster.jpg') center 45% / cover no-repeat; }
  .hero-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(to bottom, rgba(15,23,32,.55) 0%, rgba(15,23,32,0) 18%),
      linear-gradient(to top, rgba(15,23,32,.88) 0%, rgba(15,23,32,.5) 42%, rgba(15,23,32,0) 72%);
  }
  .hero-inner {
    position: absolute;
    /* Menüdeki .wrap ile aynı sol kenar */
    left: max(var(--gutter), calc((100vw - 82rem) / 2 + var(--gutter)));
    right: var(--gutter);
    bottom: clamp(2.5rem, 8vh, 5.5rem);
    max-width: 60rem;
  }
  .hero-title {
    margin: 0;
    font-size: clamp(2.75rem, 6.6vw, 6.25rem);
    font-weight: 400;
    line-height: 1.0;
    letter-spacing: -.022em;
    max-width: 14ch;
    text-wrap: balance;
  }
  .hero-place {
    margin: 1.25rem 0 0;
    font-size: clamp(1.25rem, 1.9vw, 1.625rem);
    font-style: italic;
    font-weight: 300;
    color: rgba(255,255,255,.9);
  }
  .hero-lead {
    margin: 1rem 0 0;
    max-width: var(--measure);
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.6;
    color: rgba(255,255,255,.82);
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .hero-line { border-color: rgba(255,255,255,.7); color: #fff; }
  .hero-line:hover { background: #fff; color: var(--ink); border-color: #fff; }
  .hero-note {
    margin: 1.5rem 0 0;
    font-family: var(--sans);
    font-size: .875rem;
    color: rgba(255,255,255,.7);
  }
  .hero-days { margin-left: .75rem; padding-left: .75rem; border-left: 1px solid rgba(255,255,255,.35); font-variant-numeric: lining-nums; }


  @media (max-width: 640px) {
    .hero-lead { display: none; }
    .hero-days { display: block; margin: .35rem 0 0; padding: 0; border: 0; }
  }
</style>

<script>
  const target = new Date('2027-10-04T09:00:00+03:00').getTime();
  const daysEl = document.querySelector('[data-days]');
  if (daysEl) daysEl.textContent = String(Math.max(0, Math.ceil((target - Date.now()) / 86400000)));

  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (video) {
    video.removeAttribute('autoplay');
    video.preload = 'auto';
    video.src = window.innerWidth <= 900 ? '/videos/halic-960.mp4' : '/videos/halic-1600.mp4';
    // Video tamamen akacak kadar yüklenmeden oynatma: o zamana kadar durgun kare görünür.
    if (!reduce) {
      video.addEventListener('canplaythrough', () => {
        video.play().then(() => video.classList.add('ready')).catch(() => {});
      }, { once: true });
      video.load();
    }
  }

</script>
