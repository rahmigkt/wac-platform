---
interface Props { lang: 'tr' | 'en'; i18n?: unknown; }
const { lang } = Astro.props;
const home = lang === 'en' ? '/en/' : '/';
const other = lang === 'en' ? { href: '/', label: 'Türkçe', short: 'TR' } : { href: '/en/', label: 'English', short: 'EN' };
const submitUrl = 'https://submissions.worldaerospacecongress.org/event/2/abstracts/';
const links = lang === 'en'
  ? [['#kongre', 'The congress'], ['#sempozyumlar', 'Symposia'], ['#delegasyon', 'Delegations']]
  : [['#kongre', 'Kongre'], ['#sempozyumlar', 'Sempozyumlar'], ['#delegasyon', 'Delegasyonlar']];
const submit = lang === 'en' ? 'Submit an abstract' : 'Bildiri gönder';
---

<header class="nav" id="site-nav" data-over-hero>
  <div class="nav-row">
    <a class="mark" href={home} aria-label="World Aerospace Congress 2027">
      <span class="mark-name">World Aerospace Congress</span>
      <span class="mark-year">2027</span>
    </a>

    <nav class="nav-links" aria-label={lang === 'en' ? 'Main' : 'Ana menü'}>
      {links.map(([href, label]) => <a href={home + href}>{label}</a>)}
    </nav>

    <div class="nav-end">
      <a class="lang" href={other.href} lang={lang === 'en' ? 'tr' : 'en'} aria-label={other.label}>{other.short}</a>
      <a class="nav-cta" href={submitUrl}>{submit}</a>
      <button class="menu-btn" aria-expanded="false" aria-controls="nav-sheet">
        <span class="sr">{lang === 'en' ? 'Menu' : 'Menü'}</span>
        <span class="bar"></span><span class="bar"></span>
      </button>
    </div>
  </div>

  <div class="sheet" id="nav-sheet" hidden>
    {links.map(([href, label]) => <a href={home + href}>{label}</a>)}
    <a href={submitUrl}>{submit}</a>
    <a href={other.href}>{other.label}</a>
  </div>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    color: #fff;
    transition: background-color .3s, color .3s, border-color .3s;
    border-bottom: 1px solid transparent;
  }
  .nav.solid {
    background: rgba(255,255,255,.97);
    color: var(--ink);
    border-bottom-color: var(--rule);
    backdrop-filter: saturate(1.2) blur(6px);
  }
  .nav-row {
    max-width: 82rem; margin: 0 auto;
    padding: 0 var(--gutter);
    height: 4.5rem;
    display: flex; align-items: center; gap: 2.5rem;
  }

  .mark { display: flex; align-items: baseline; gap: .55rem; text-decoration: none; color: inherit; flex-shrink: 0; }
  .mark-name { font-family: var(--serif); font-size: 1.1875rem; font-weight: 500; letter-spacing: -.005em; }
  .mark-year { font-family: var(--serif); font-size: 1.1875rem; font-weight: 300; opacity: .7; font-variant-numeric: lining-nums; }

  .nav-links { display: flex; gap: 2rem; margin-left: auto; }
  .nav-links a, .lang {
    font-family: var(--sans); font-size: .9375rem;
    text-decoration: none; color: inherit; opacity: .85;
  }
  .nav-links a:hover, .lang:hover { opacity: 1; text-decoration: underline; text-underline-offset: .3em; text-decoration-thickness: 1px; }

  .nav-end { display: flex; align-items: center; gap: 1.5rem; }
  .nav-cta {
    font-family: var(--sans); font-size: .9375rem; font-weight: 500;
    text-decoration: none; color: inherit;
    padding: .55rem 1.1rem;
    border: 1px solid currentColor; border-radius: 2px;
  }
  .nav.solid .nav-cta { background: var(--oxblood); border-color: var(--oxblood); color: #fff; }
  .nav-cta:hover { background: #fff; color: var(--ink); border-color: #fff; }
  .nav.solid .nav-cta:hover { background: var(--oxblood-deep); border-color: var(--oxblood-deep); color: #fff; }

  .menu-btn { display: none; background: none; border: 0; padding: .5rem; color: inherit; cursor: pointer; }
  .bar { display: block; width: 22px; height: 1.5px; background: currentColor; margin: 5px 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  .sheet {
    background: #fff; color: var(--ink);
    border-top: 1px solid var(--rule);
    padding: .5rem var(--gutter) 1.25rem;
    display: flex; flex-direction: column;
  }
  .sheet[hidden] { display: none; }
  .sheet a {
    font-family: var(--serif); font-size: 1.25rem;
    padding: .8rem 0; border-bottom: 1px solid var(--rule);
    text-decoration: none; color: inherit;
  }
  .sheet a:last-child { border-bottom: 0; }

  @media (max-width: 960px) {
    .nav-links, .nav-cta, .lang { display: none; }
    .menu-btn { display: block; }
    .nav-end { margin-left: auto; }
  }
  @media (max-width: 420px) {
    .mark-name { font-size: 1.0625rem; }
  }
</style>

<script>
  const nav = document.getElementById('site-nav');
  const hero = document.querySelector('.hero');
  const btn = nav?.querySelector<HTMLButtonElement>('.menu-btn');
  const sheet = document.getElementById('nav-sheet');

  function update() {
    const limit = hero ? hero.getBoundingClientRect().height - 80 : 0;
    const open = sheet && !sheet.hidden;
    nav?.classList.toggle('solid', window.scrollY > limit || !!open || !hero);
  }
  update();
  window.addEventListener('scroll', update, { passive: true });

  btn?.addEventListener('click', () => {
    if (!sheet) return;
    sheet.hidden = !sheet.hidden;
    btn.setAttribute('aria-expanded', String(!sheet.hidden));
    update();
  });
  sheet?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { sheet.hidden = true; btn?.setAttribute('aria-expanded', 'false'); update(); }));
</script>
