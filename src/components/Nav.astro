---
interface Props {
  lang: 'tr' | 'en';
  i18n: Record<string, string>;
}

const { lang, i18n } = Astro.props;
const base = lang === 'en' ? '/en' : '';
const altLang = lang === 'en' ? '' : '/en';
const altLabel = lang === 'en' ? 'TR' : 'EN';
---

<header class="nav-wrapper" id="main-nav">
  <div class="nav-inner">
    <!-- Logo -->
    <a href={base + '/'} class="nav-logo" aria-label="WAC 2027">
      <span class="logo-wac">WAC</span>
      <span class="logo-year">2027</span>
    </a>

    <!-- Links -->
    <nav class="nav-links" aria-label="Ana navigasyon">
      <a href={base + '/about'} class="nav-link">{i18n.about}</a>
      <a href={base + '/symposia'} class="nav-link">{i18n.symposia}</a>
      <a href={base + '/speakers'} class="nav-link">{i18n.speakers}</a>
      <a href={base + '/delegation'} class="nav-link">{i18n.delegation}</a>
      <a href={base + '/submissions'} class="nav-link">{i18n.submissions}</a>
      <a href={base + '/program'} class="nav-link">{i18n.program}</a>
      <a href={base + '/news'} class="nav-link">{i18n.news}</a>
    </nav>

    <!-- Right side -->
    <div class="nav-actions">
      <a href={altLang + '/'} class="lang-switch" aria-label="Switch language">{altLabel}</a>
      <a href={base + '/registration'} class="btn-primary" style="font-size:0.8125rem; padding: 0.5rem 1.25rem;">{i18n.register}</a>
    </div>

    <!-- Mobile toggle -->
    <button class="mobile-toggle" aria-label="Menüyü aç" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <a href={base + '/about'} class="mobile-link">{i18n.about}</a>
    <a href={base + '/symposia'} class="mobile-link">{i18n.symposia}</a>
    <a href={base + '/speakers'} class="mobile-link">{i18n.speakers}</a>
    <a href={base + '/delegation'} class="mobile-link">{i18n.delegation}</a>
    <a href={base + '/submissions'} class="mobile-link">{i18n.submissions}</a>
    <a href={base + '/program'} class="mobile-link">{i18n.program}</a>
    <a href={base + '/news'} class="mobile-link">{i18n.news}</a>
    <a href={base + '/registration'} class="mobile-link mobile-link--cta">{i18n.register}</a>
    <a href={altLang + '/'} class="mobile-link">{altLabel}</a>
  </div>
</header>

<style>
  .nav-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: transparent;
    transition: background 0.3s, backdrop-filter 0.3s;
  }

  .nav-wrapper.scrolled {
    background: rgba(10, 22, 40, 0.97);
    backdrop-filter: blur(8px);
  }

  .nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 4rem;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-logo {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-wac {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: #fff;
    letter-spacing: 0.08em;
  }

  .logo-year {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 300;
    color: var(--brass-light);
    letter-spacing: 0.06em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex: 1;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  .lang-switch {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    transition: color 0.2s;
  }

  .lang-switch:hover {
    color: var(--brass-light);
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-left: auto;
  }

  .mobile-toggle span {
    display: block;
    width: 22px;
    height: 1px;
    background: rgba(255,255,255,0.8);
    transition: all 0.2s;
  }

  .mobile-menu {
    background: var(--night);
    padding: 1rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid rgba(184,150,110,0.2);
  }

  .mobile-link {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9375rem;
    font-weight: 300;
    color: rgba(255,255,255,0.8);
    text-decoration: none;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    transition: color 0.2s;
  }

  .mobile-link:hover {
    color: var(--brass-light);
  }

  .mobile-link--cta {
    color: var(--brass-light);
    border-bottom: none;
    padding-top: 1rem;
  }

  @media (max-width: 900px) {
    .nav-links, .nav-actions .btn-primary, .nav-actions .lang-switch {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
  }
</style>

<script>
  // Scroll effect
  const nav = document.getElementById('main-nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) nav?.classList.add('scrolled');
    else nav?.classList.remove('scrolled');
  }, { passive: true });

  // Mobile toggle
  const toggle = document.querySelector('.mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.hidden === false;
    if (menu) menu.hidden = open;
    toggle.setAttribute('aria-expanded', String(!open));
  });
</script>
