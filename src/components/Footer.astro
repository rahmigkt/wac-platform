---
interface Props { lang: 'tr' | 'en'; i18n?: unknown; }
const { lang } = Astro.props;
const en = lang === 'en';
const home = en ? '/en/' : '/';
const submitUrl = 'https://submissions.worldaerospacecongress.org/event/2/abstracts/';
---

<footer class="foot">
  <div class="wrap foot-grid">
    <div class="foot-org">
      <img src="/images/tbtk-amblem.svg" alt="" width="56" height="49" />
      <p>
        {en ? 'Organised by' : 'Düzenleyen'}<br />
        <strong>{en ? 'Turkish Society for History of Science' : 'Türk Bilim Tarihi Kurumu'}</strong>
      </p>
    </div>

    <nav class="foot-links" aria-label={en ? 'Footer' : 'Alt menü'}>
      <a href={home + '#kongre'}>{en ? 'The congress' : 'Kongre'}</a>
      <a href={home + '#sempozyumlar'}>{en ? 'Symposia' : 'Sempozyumlar'}</a>
      <a href={home + '#delegasyon'}>{en ? 'Delegations' : 'Delegasyonlar'}</a>
      <a href={submitUrl}>{en ? 'Submit an abstract' : 'Bildiri gönder'}</a>
    </nav>

    <p class="foot-meta">
      World Aerospace Congress 2027<br />
      {en ? 'Istanbul, October 2027' : 'İstanbul, Ekim 2027'}<br />
      <a href={en ? '/' : '/en/'}>{en ? 'Türkçe' : 'English'}</a>
    </p>
  </div>
  <div class="wrap foot-base">
    <p>© 2026 {en ? 'Turkish Society for History of Science' : 'Türk Bilim Tarihi Kurumu Derneği'}</p>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--rule); padding: 3.5rem 0 2rem; margin-top: 0; color: var(--ink); background: var(--paper); }
  .foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 3rem; align-items: start; }
  .foot-org { display: flex; gap: 1rem; align-items: center; }
  .foot-org p { margin: 0; font-family: var(--sans); font-size: .875rem; line-height: 1.5; color: var(--slate); }
  .foot-org strong { font-family: var(--serif); font-size: 1.0625rem; font-weight: 500; color: var(--ink); }
  .foot-links { display: flex; flex-direction: column; gap: .5rem; }
  .foot-links a, .foot-meta a { font-family: var(--sans); font-size: .9375rem; color: var(--ink); text-decoration: none; }
  .foot-links a:hover, .foot-meta a:hover { text-decoration: underline; text-underline-offset: .3em; }
  .foot-meta { margin: 0; font-family: var(--sans); font-size: .9375rem; line-height: 1.7; color: var(--slate); }
  .foot-base { margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--rule); }
  .foot-base p { margin: 0; font-family: var(--sans); font-size: .8125rem; color: var(--slate); }
  @media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>
