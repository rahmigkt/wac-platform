---
interface Props {
  lang: 'tr' | 'en';
  i18n: Record<string, string>;
}

const { lang, i18n } = Astro.props;
const base = lang === 'en' ? '/en' : '';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="footer-logo-wac">WAC</span>
        <span class="footer-logo-year">2027</span>
        <p class="footer-tagline">World Aerospace Congress<br>İstanbul · Ekim 2027</p>
      </div>

      <div class="footer-links">
        <div class="footer-col">
          <p class="footer-col-head">{lang === 'tr' ? 'Kongre' : 'Congress'}</p>
          <a href={base + '/about'}>{lang === 'tr' ? 'Kongre Hakkında' : 'About'}</a>
          <a href={base + '/symposia'}>{lang === 'tr' ? 'Sempozyumlar' : 'Symposia'}</a>
          <a href={base + '/program'}>{lang === 'tr' ? 'Program' : 'Program'}</a>
          <a href={base + '/speakers'}>{lang === 'tr' ? 'Konuşmacılar' : 'Speakers'}</a>
        </div>
        <div class="footer-col">
          <p class="footer-col-head">{lang === 'tr' ? 'Katılım' : 'Participate'}</p>
          <a href={base + '/delegation'}>{lang === 'tr' ? 'Delegasyon' : 'Delegation'}</a>
          <a href={base + '/submissions'}>{lang === 'tr' ? 'Bildiri Başvurusu' : 'Submit a Paper'}</a>
          <a href={base + '/registration'}>{lang === 'tr' ? 'Kayıt' : 'Register'}</a>
        </div>
        <div class="footer-col">
          <p class="footer-col-head">{lang === 'tr' ? 'Bilgi' : 'Info'}</p>
          <a href={base + '/news'}>{lang === 'tr' ? 'Haberler' : 'News'}</a>
          <a href={base + '/contact'}>{i18n.contact}</a>
          <a href={base + '/privacy'}>{i18n.privacy}</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {i18n.organizer}. {i18n.rights}.</p>
      <p class="footer-site">worldaerospacecongress.org</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--night);
    color: rgba(255,255,255,0.6);
    padding: 4rem 0 2rem;
    margin-top: 6rem;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    margin-bottom: 2rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
  }

  .footer-logo-wac {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 400;
    color: #fff;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .footer-logo-year {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 300;
    color: var(--brass);
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }

  .footer-tagline {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.4);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-col-head {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 0.25rem;
  }

  .footer-col a {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: rgba(255,255,255,0.9);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.3);
  }

  .footer-site {
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-links {
      grid-template-columns: repeat(2, 1fr);
    }
    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .footer-links {
      grid-template-columns: 1fr;
    }
  }
</style>
