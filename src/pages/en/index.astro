---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../i18n';

const lang = 'en';
const i18n = t(lang);
---

<Layout
  lang={lang}
  title="WAC 2027 — First World Aerospace Congress"
  description="The First World Aerospace Congress. Istanbul, October 2027. Organized by Turkish Society for History of Science."
>

  <!-- ═══ HERO ═══ -->
  <section class="hero" aria-label="Hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-grid"></div>
      <div class="hero-gradient"></div>
    </div>

    <div class="hero-inner">
      <div class="hero-meta">
        <span class="hero-edition">{i18n.hero.edition}</span>
      </div>

      <h1 class="hero-title">
        <span class="hero-title-line">World Aerospace</span>
        <span class="hero-title-line hero-title-line--accent">Congress</span>
      </h1>

      <div class="hero-dateline">
        <span class="hero-date">{i18n.hero.date}</span>
        <span class="hero-sep" aria-hidden="true">—</span>
        <span class="hero-location">{i18n.hero.location}</span>
      </div>

      <p class="hero-tagline">{i18n.hero.tagline}</p>

      <div class="hero-actions">
        <a href="/en/delegation" class="btn-primary">{i18n.hero.cta_delegation}</a>
        <a href="/en/about" class="btn-outline">{i18n.hero.cta_about}</a>
      </div>

      <div class="hero-org">
        <span class="hero-org-label">{i18n.hero.organized_by}</span>
        <span class="hero-org-name">Turkish Society for History of Science (TBTK)</span>
      </div>
    </div>

    <!-- Countdown -->
    <div class="countdown-strip">
      <div class="countdown-inner">
        <p class="countdown-label">{i18n.countdown.until}</p>
        <div class="countdown-units" id="countdown">
          <div class="countdown-unit"><span class="cd-num" id="cd-days">—</span><span class="cd-label">{i18n.countdown.days}</span></div>
          <div class="countdown-unit"><span class="cd-num" id="cd-hours">—</span><span class="cd-label">{i18n.countdown.hours}</span></div>
          <div class="countdown-unit"><span class="cd-num" id="cd-minutes">—</span><span class="cd-label">{i18n.countdown.minutes}</span></div>
          <div class="countdown-unit"><span class="cd-num" id="cd-seconds">—</span><span class="cd-label">{i18n.countdown.seconds}</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ABOUT ═══ -->
  <section class="section-about">
    <div class="container">
      <div class="about-grid">
        <div class="about-text">
          <span class="section-label">{i18n.about.label}</span>
          <span class="brass-line" style="margin: 1rem 0;"></span>
          <h2 class="about-title">{i18n.about.title}</h2>
          <p class="about-body">{i18n.about.body}</p>
        </div>

        <div class="about-facts">
          <div class="fact">
            <p class="fact-label">{i18n.about.triennial_label}</p>
            <p class="fact-desc">{i18n.about.triennial_desc}</p>
          </div>
          <div class="fact">
            <p class="fact-label">{i18n.about.organizer_label}</p>
            <p class="fact-desc">{i18n.about.organizer_desc}</p>
          </div>
          <div class="fact">
            <p class="fact-label">{i18n.about.declaration_label}</p>
            <p class="fact-desc">{i18n.about.declaration_desc}</p>
          </div>
          <div class="fact fact--continuity">
            <p class="fact-label">WAC 2033</p>
            <p class="fact-desc">Targeted in Istanbul on the occasion of Turkish Airlines' centenary</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SYMPOSIA ═══ -->
  <section class="section-symposia">
    <div class="container">
      <div class="symposia-header">
        <span class="section-label">{i18n.symposia.label}</span>
        <span class="brass-line" style="margin: 1rem 0;"></span>
        <h2 class="symposia-title">{i18n.symposia.title}</h2>
      </div>

      <div class="symposia-list">
        {i18n.symposia.items.map((item: {num: string; title: string}) => (
          <div class="symposium-row">
            <span class="sym-num">{item.num}</span>
            <span class="sym-title">{item.title}</span>
            <a href={`/en/symposia#s${item.num}`} class="sym-link" aria-label={item.title}>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        ))}
      </div>

      <div class="symposia-forum">
        <div class="forum-box">
          <p class="forum-label">Global Aerospace Forum</p>
          <p class="forum-desc">Industry leaders, CEOs, sector pioneers, policymakers, and academics discuss the latest developments in artificial intelligence, sustainability, space economy, and UAV technologies.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ DELEGATION ═══ -->
  <section class="section-delegation">
    <div class="container">
      <div class="delegation-grid">
        <div class="delegation-text">
          <span class="section-label" style="color: var(--brass-light);">{i18n.delegation.label}</span>
          <span class="brass-line" style="margin: 1rem 0;"></span>
          <h2 class="delegation-title">{i18n.delegation.title}</h2>
          <p class="delegation-body">{i18n.delegation.body}</p>
          <a href="/en/delegation" class="btn-primary" style="margin-top: 2rem;">{i18n.delegation.cta}</a>
        </div>

        <div class="delegation-who">
          <p class="who-label">{i18n.delegation.who_can}</p>
          <ul class="who-list">
            {i18n.delegation.who_list.map((item: string) => (
              <li class="who-item">
                <span class="who-dot" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero { position: relative; min-height: 100vh; display: flex; flex-direction: column; background: var(--night); overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; pointer-events: none; }
  .hero-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(184,150,110,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(184,150,110,0.06) 1px, transparent 1px); background-size: 80px 80px; }
  .hero-gradient { position: absolute; inset: 0; background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(184,150,110,0.12) 0%, transparent 60%), linear-gradient(to bottom, transparent 60%, var(--night) 100%); }
  .hero-inner { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: 10rem 1.5rem 6rem; flex: 1; display: flex; flex-direction: column; justify-content: center; }
  .hero-meta { margin-bottom: 2rem; }
  .hero-edition { font-family: 'DM Sans', sans-serif; font-size: 0.75rem; font-weight: 400; letter-spacing: 0.12em; color: var(--brass); text-transform: uppercase; }
  .hero-title { display: flex; flex-direction: column; font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: clamp(3.5rem, 8vw, 7.5rem); line-height: 0.95; letter-spacing: -0.02em; color: #fff; margin-bottom: 2rem; }
  .hero-title-line--accent { color: var(--brass-light); font-style: italic; }
  .hero-dateline { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .hero-date, .hero-location { font-family: 'DM Sans', sans-serif; font-size: 0.9375rem; font-weight: 300; color: rgba(255,255,255,0.6); letter-spacing: 0.03em; }
  .hero-sep { color: var(--brass); opacity: 0.5; }
  .hero-tagline { font-family: 'DM Sans', sans-serif; font-size: 1.0625rem; font-weight: 300; line-height: 1.65; color: rgba(255,255,255,0.55); max-width: 520px; margin-bottom: 2.5rem; white-space: pre-line; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 3rem; }
  .hero-org { display: flex; align-items: center; gap: 0.75rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.1); }
  .hero-org-label { font-family: 'DM Sans', sans-serif; font-size: 0.6875rem; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.3); }
  .hero-org-name { font-family: 'DM Sans', sans-serif; font-size: 0.875rem; font-weight: 300; color: rgba(255,255,255,0.6); }
  .countdown-strip { position: relative; z-index: 1; border-top: 1px solid rgba(184,150,110,0.2); background: rgba(10,22,40,0.8); backdrop-filter: blur(8px); }
  .countdown-inner { max-width: 1280px; margin: 0 auto; padding: 1.5rem; display: flex; align-items: center; gap: 3rem; }
  .countdown-label { font-family: 'DM Sans', sans-serif; font-size: 0.6875rem; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.35); white-space: nowrap; }
  .countdown-units { display: flex; gap: 2rem; }
  .countdown-unit { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; }
  .cd-num { font-family: 'Cormorant Garamond', serif; font-size: 2rem; font-weight: 300; color: #fff; line-height: 1; min-width: 2.5ch; text-align: center; }
  .cd-label { font-family: 'DM Sans', sans-serif; font-size: 0.625rem; font-weight: 400; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brass); }
  .container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }
  .section-about { padding: 6rem 0; }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
  .about-title { font-size: clamp(2rem, 3.5vw, 3rem); color: var(--text); margin-bottom: 1.5rem; }
  .about-body { font-family: 'DM Sans', sans-serif; font-size: 1rem; font-weight: 300; line-height: 1.75; color: var(--text-muted); max-width: 52ch; }
  .about-facts { display: flex; flex-direction: column; gap: 0; }
  .fact { padding: 1.5rem 0; border-bottom: 1px solid var(--mist); }
  .fact:first-child { border-top: 1px solid var(--mist); }
  .fact--continuity .fact-label { color: var(--brass); }
  .fact-label { font-family: 'DM Sans', sans-serif; font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.375rem; }
  .fact-desc { font-family: 'DM Sans', sans-serif; font-size: 0.9375rem; font-weight: 300; line-height: 1.55; color: var(--text); }
  .section-symposia { padding: 6rem 0; background: var(--mist); }
  .symposia-header { margin-bottom: 3rem; }
  .symposia-title { font-size: clamp(2rem, 3.5vw, 3rem); color: var(--text); }
  .symposia-list { display: flex; flex-direction: column; border-top: 1px solid rgba(0,0,0,0.1); margin-bottom: 3rem; }
  .symposium-row { display: grid; grid-template-columns: 3rem 1fr auto; align-items: center; gap: 1.5rem; padding: 1.25rem 0; border-bottom: 1px solid rgba(0,0,0,0.08); }
  .sym-num { font-family: 'DM Sans', sans-serif; font-size: 0.75rem; font-weight: 400; color: var(--brass); letter-spacing: 0.05em; }
  .sym-title { font-family: 'Cormorant Garamond', serif; font-size: 1.375rem; font-weight: 400; color: var(--text); letter-spacing: -0.01em; }
  .sym-link { color: var(--text-muted); opacity: 0; transition: opacity 0.2s; }
  .symposium-row:hover .sym-link { opacity: 1; color: var(--brass); }
  .forum-box { padding: 2rem; background: var(--night); max-width: 640px; }
  .forum-label { font-family: 'Cormorant Garamond', serif; font-size: 1.25rem; font-weight: 400; color: var(--brass-light); margin-bottom: 0.75rem; }
  .forum-desc { font-family: 'DM Sans', sans-serif; font-size: 0.875rem; font-weight: 300; line-height: 1.7; color: rgba(255,255,255,0.55); }
  .section-delegation { padding: 6rem 0; background: var(--night); }
  .delegation-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
  .delegation-title { font-size: clamp(2rem, 3.5vw, 3rem); color: #fff; margin-bottom: 1.5rem; }
  .delegation-body { font-family: 'DM Sans', sans-serif; font-size: 1rem; font-weight: 300; line-height: 1.75; color: rgba(255,255,255,0.55); max-width: 52ch; }
  .who-label { font-family: 'DM Sans', sans-serif; font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--brass); margin-bottom: 1.5rem; }
  .who-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
  .who-item { display: flex; align-items: center; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid rgba(255,255,255,0.07); font-family: 'DM Sans', sans-serif; font-size: 0.9375rem; font-weight: 300; color: rgba(255,255,255,0.7); }
  .who-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--brass); flex-shrink: 0; }
  @media (max-width: 900px) { .about-grid, .delegation-grid { grid-template-columns: 1fr; gap: 3rem; } .countdown-inner { flex-direction: column; gap: 1rem; align-items: flex-start; } }
</style>

<script>
  const target = new Date('2027-10-01T09:00:00+03:00');
  function pad(n: number) { return String(n).padStart(2, '0'); }
  function tick() {
    const diff = target.getTime() - new Date().getTime();
    if (diff <= 0) return;
    const days = Math.floor(diff / 86400000);
    const hours = Math.floor((diff % 86400000) / 3600000);
    const mins = Math.floor((diff % 3600000) / 60000);
    const secs = Math.floor((diff % 60000) / 1000);
    const el = (id: string) => document.getElementById(id);
    const d = el('cd-days'), h = el('cd-hours'), m = el('cd-minutes'), s = el('cd-seconds');
    if (d) d.textContent = String(days); if (h) h.textContent = pad(hours); if (m) m.textContent = pad(mins); if (s) s.textContent = pad(secs);
  }
  tick(); setInterval(tick, 1000);
</script>
